# Paywise frontend environment variables (placeholders only — never commit real values)

# Mode A (recommended for local development) — same-origin proxy.
# The Next.js server forwards /api/* to this origin, so the browser only ever
# makes same-origin requests: no CORS configuration is required on the backend.
# This value is read on the server only and is not exposed to the browser.
PAYWISE_API_ORIGIN=http://127.0.0.1:8000

# Mode B — direct browser calls to the backend.
# The backend must allow http://localhost:3000 through CORS and trust it for CSRF.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# When "true", read views render clearly-labelled fixture data instead of calling the API.
# Write actions (creating/submitting requests) stay disabled in demo mode; nothing is faked.
NEXT_PUBLIC_DEMO_MODE=false

# When "true", the sign-in page lists one-click demo accounts (seeded by
# `manage.py seed_demo`, shared password). Keep unset in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
